TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Optional: template mode replaces custom replies with the selected template.
TWILIO_CONTENT_SID=
TWILIO_CONTENT_VARIABLES={}
VALIDATE_TWILIO_REQUESTS=true
PORT=5000
# Exact public HTTPS URL configured in Twilio, including /whatsapp and any query.
PUBLIC_WEBHOOK_URL=
# Private bearer token for /send. Leaving blank disables manual sending.
SEND_API_KEY=
